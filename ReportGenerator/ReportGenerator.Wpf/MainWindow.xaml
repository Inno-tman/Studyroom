<Window x:Class="ReportGenerator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:ReportGenerator.Wpf.Models"
        mc:Ignorable="d"
        Title="AI Report Generator" Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AI-Powered Report Generator" FontSize="20" FontWeight="Bold"
                           Foreground="#1976D2" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sign in with Google" Command="{Binding SignInWithGoogleCommand}"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource InvBoolToVis}}"
                            Style="{StaticResource PrimaryButton}"/>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#E0E0E0"
                                BorderBrush="#C0C0C0" BorderThickness="1">
                            <Image Source="{Binding GoogleAvatarUrl, Converter={StaticResource UrlToImage}, IsAsync=True}"
                                   Width="28" Height="28" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GoogleDisplayName}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding GoogleEmail}" FontSize="11" Foreground="#666"/>
                        </StackPanel>
                        <Button Content="Sign Out" Command="{Binding SignOutCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Database Connection" Style="{StaticResource SectionHeader}"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Database:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding DatabaseTypes}"
                          SelectedItem="{Binding SelectedDatabaseType}" Margin="0,0,6,0"/>
                <TextBox Grid.Column="2" Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,6,0">
                    <TextBox.Template>
                        <ControlTemplate>
                            <Border BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="2"
                                    Background="White" Padding="4,2">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="TextBox.Text" Value="">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <Button Grid.Column="3" Content="Test" Command="{Binding TestConnectionCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" MinWidth="60"/>
                <Button Grid.Column="4" Content="Load Schema" Command="{Binding LoadSchemaCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="100"/>
            </Grid>

            <TextBlock Text="AI Settings" Style="{StaticResource SectionHeader}"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Groq API Key:" VerticalAlignment="Center"/>
                <PasswordBox Grid.Column="1" x:Name="ApiKeyBox" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="2" Text="Model:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                <TextBox Grid.Column="3" Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Groq model (e.g., llama-3.3-70b-versatile, mixtral-8x7b-32768)"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Google Client ID:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OAuth Client ID from Google Cloud Console (app type: Desktop). Used for Google Sign-In."/>
            </Grid>

            <TextBlock Text="Report Prompt" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="50" MaxHeight="80" AcceptsReturn="True"
                         TextWrapping="Wrap" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Generate Report" Command="{Binding GenerateReportCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="130" MinHeight="40"
                        FontSize="14"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="#F0F0F0" Padding="8,6" CornerRadius="4" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             Height="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalRows, StringFormat='Rows: {0}'}"
                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#666"/>
                <Button Grid.Column="3" Content="Export to Excel" Command="{Binding ExportToExcelCommand}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource SecondaryButton}" MinWidth="120"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Expander Grid.Row="0" Header="Generated SQL" IsExpanded="False" Margin="0,0,0,4">
                <TextBox Text="{Binding GeneratedSql, Mode=OneWay}"
                         FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="150"
                         Background="#1E1E1E" Foreground="#D4D4D4" Padding="6"/>
            </Expander>
            <DataGrid Grid.Row="1" ItemsSource="{Binding LastResult.Rows}"
                      AutoGenerateColumns="True" IsReadOnly="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#F5F5F5" RowHeaderWidth="0"
                      BorderBrush="#D0D0D0" BorderThickness="1"/>
        </Grid>

        <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,4,0,0">
            <TextBlock Text="{Binding OutputFilePath, Mode=OneWay}" Foreground="#666"
                       TextTrimming="CharacterEllipsis" FontSize="11"/>
        </Border>
    </Grid>
</Window>
